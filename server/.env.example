NODE_ENV=development
PORT=3001

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=nest_db
DB_INIT_MODE=migrate
INTERNAL_METRICS_ENABLED=0
LOG_TO_FILE=0
LOG_DIR=./logs
LOG_WEBHOOK_ENABLED=0
LOG_WEBHOOK_URL=
LOG_WEBHOOK_MIN_LEVEL=error

JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM_NAME=NEST English
SMTP_FROM_EMAIL=replace_me

# 允许访问的跨域来源，多个用英文逗号分隔；生产环境必须是 https 域名
ALLOWED_ORIGIN=https://nestenglish.com
# Cookie 域（生产环境建议设为根域，允许子域共享登录态）
COOKIE_DOMAIN=

AI_PROVIDER=volcengine
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_DEFAULT_MODEL=replace_me
AI_API_KEY=replace_me
# 允许使用的模型白名单（逗号分隔），为空时允许 AI_DEFAULT_MODEL
AI_ALLOWED_MODELS=

VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_APP_KEY=replace_me
VOLCENGINE_ASR_ACCESS_KEY=replace_me
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# 语音合成（TTS）
VOLCENGINE_TTS_APPID=replace_me
VOLCENGINE_TTS_TOKEN=replace_me
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE=zh_female_qingxin
# 生成的音频文件落盘目录（相对于 server/ 或绝对路径）
TTS_DATA_DIR=./data/tts

OSS_REGION=replace_me
OSS_ACCESS_KEY_ID=replace_me
OSS_ACCESS_KEY_SECRET=replace_me
OSS_BUCKET=replace_me
# 可选：覆盖 OSS 图片/文件公开访问基础 URL（用于 CDN）
OSS_PUBLIC_BASE_URL=
CDN_URL=
COURSE_IMAGE_BASE_URL=

QUESTION_ANALYSIS_EMBEDDED_WORKER=1
REDIS_URL=redis://127.0.0.1:6379

# 阿里云短信（生产环境必填；开发环境留空则自动跳过实际发送，验证码会在响应中返回）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# RAG 知识库：Markdown 资料目录（多个用系统路径分隔符 : 分隔）。
# 留空时知识库检索静默返回空，不影响主流程。
NEST_KNOWLEDGE_DIRS=
# 兼容旧变量名（IELTS 知识库目录）
IELTS_KNOWLEDGE_DIR=

# 登录安全
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_MAX_FAILED_ATTEMPTS=50
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_ATTEMPT_LOCK_MS=600000
# 用户状态缓存 TTL（毫秒）
AUTH_USER_STATE_TTL_MS=3600000

# 支付（测试期 mock 开关）
ENABLE_CAMP_MOCK_PAY=0
# 线下支付二维码图片地址，用于管理员上传的收款码
MANUAL_PAYMENT_QR_URL=

# 内部：loadEnv 会优先读取此文件；一般无需修改
NEST_SERVER_ENV_FILE=.env
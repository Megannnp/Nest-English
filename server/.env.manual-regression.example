# Template only. Copy to server/.env.manual-regression.local for manual regression, and keep real secrets out of the repo.
NODE_ENV=development
PORT=3101

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=nest_db_manual_regression
DB_INIT_MODE=migrate
NEST_RUNTIME_ROLE=all
INTERNAL_METRICS_ENABLED=0
LOG_TO_FILE=0
LOG_DIR=./logs
LOG_WEBHOOK_ENABLED=0
LOG_WEBHOOK_URL=
LOG_WEBHOOK_MIN_LEVEL=error

JWT_SECRET=replace_with_manual_regression_secret
JWT_EXPIRES_IN=7d
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_ATTEMPT_LOCK_MS=900000

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=replace_with_smtp_password_or_app_token
SMTP_FROM_NAME=NEST Writing Manual Regression
SMTP_FROM_EMAIL=noreply@example.com

AI_PROVIDER=volcengine
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_DEFAULT_MODEL=replace_me
AI_API_KEY=replace_me
GUEST_AI_ANALYZE_TAGS_MAX=12
GUEST_AI_RECOGNIZE_TEXT_MAX=4
GUEST_AI_ANALYZE_TAGS_WINDOW_MS=3600000
GUEST_AI_RECOGNIZE_TEXT_WINDOW_MS=3600000

OSS_REGION=replace_me
OSS_ACCESS_KEY_ID=replace_me
OSS_ACCESS_KEY_SECRET=replace_me
OSS_BUCKET=replace_me

QUESTION_ANALYSIS_EMBEDDED_WORKER=1
FEEDBACK_EMBEDDED_WORKER=1
BATCH_GRADING_EMBEDDED_WORKER=1
REDIS_URL=redis://127.0.0.1:6379
